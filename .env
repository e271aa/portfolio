# Public address of the site, used for the share image and links in <head>.
# Empty = relative paths (fine for local work). Set it in .env.production once the domain exists,
# e.g. VITE_SITE_URL=https://example.com (no trailing slash).
VITE_SITE_URL=

# Nook, in the Projects section. Each button only appears when its address is set here
# (or in .env.production / .env.local); empty = no button.
# e.g. VITE_DEMO_URL=https://demo.e271aa.blog/casa
VITE_DEMO_URL=
VITE_NOOK_REPO_URL=
